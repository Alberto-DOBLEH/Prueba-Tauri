{
  "name": "pos-frontend-tauri",
  "version": "1.0.8",
  "description": "Frontend React y contenedor Tauri para punto de venta local.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:linux": "tauri build --bundles rpm",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "tauri:build:windows:exe": "tauri build --bundles nsis",
    "tauri:build:windows:msi": "tauri build --bundles msi",
    "clean:windows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force dist,src-tauri/target -ErrorAction SilentlyContinue\"",
    "tauri:build:windows:clean": "npm run clean:windows && npm run tauri:build:windows",
    "tauri:build:windows:msi:clean": "npm run clean:windows && npm run tauri:build:windows:msi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jspdf": "^2.5.2",
    "vite": "^6.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.5"
  }
}
